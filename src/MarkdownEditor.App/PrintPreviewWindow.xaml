<Window x:Class="MarkdownEditor.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Print Preview"
        Width="920"
        Height="760"
        MinWidth="640"
        MinHeight="480"
        Loaded="Window_Loaded">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F5F7" BorderBrush="#D7DCE3" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button Content="Print…" Click="Print_Click" />
                <Button Content="Close" Click="Close_Click" />
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="PreviewWebView" DefaultBackgroundColor="White" />
    </DockPanel>
</Window>
