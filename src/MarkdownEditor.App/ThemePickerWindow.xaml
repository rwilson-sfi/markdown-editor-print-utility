<Window x:Class="MarkdownEditor.App.ThemePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose a palette"
        Width="930"
        Height="650"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        PreviewKeyDown="Window_PreviewKeyDown"
        AutomationProperties.Name="Palette gallery">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PickerFilterStyle" TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource ModeToggleStyle}">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PickerFilterLastStyle" TargetType="{x:Type RadioButton}"
               BasedOn="{StaticResource PickerFilterStyle}">
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="PickerCardStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Height" Value="128" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CardChrome" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CardChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CardChrome" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,18,22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="P A L E T T E  G A L L E R Y" FontSize="9" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Choose your workspace atmosphere" FontSize="22" FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock Text="Every built-in Hermes palette, arranged for quick visual scanning."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource SecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="11,6" VerticalAlignment="Center">
                    <TextBlock x:Name="CatalogSummaryText" Text="11 BUILT-INS" FontSize="9"
                               FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid MaxWidth="470" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox" Height="34" Padding="32,7,10,7"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBrush}" BorderThickness="1"
                             TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="Search palettes" />
                    <TextBlock Text="⌕" Margin="10,0,0,1" FontSize="18"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchHint" Text="Search by name or mood…" Margin="32,0,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="AllFilter" Content="ALL" GroupName="PaletteFilter"
                                 IsChecked="True" Tag="all" Style="{StaticResource PickerFilterStyle}"
                                 Click="Filter_Click" AutomationProperties.Name="Show all palettes" />
                    <RadioButton Content="LIGHT" GroupName="PaletteFilter" Tag="light"
                                 Style="{StaticResource PickerFilterStyle}" Click="Filter_Click"
                                 AutomationProperties.Name="Show light palettes" />
                    <RadioButton Content="DARK" GroupName="PaletteFilter" Tag="dark"
                                 Style="{StaticResource PickerFilterLastStyle}" Click="Filter_Click"
                                 AutomationProperties.Name="Show dark palettes" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="14,12">
            <Grid>
                <ItemsControl ItemsSource="{Binding VisibleThemes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PickerCardStyle}" Click="ThemeCard_Click"
                                    AutomationProperties.Name="{Binding Theme.DisplayName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding Theme.Background}" />
                                        <Border Grid.Column="1" Background="{Binding Theme.Card}" />
                                        <Border Grid.Column="2" Background="{Binding Theme.Primary}" />
                                        <Border Grid.Column="3" Background="{Binding Theme.Ring}" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource AccentBrush}" Padding="7,3"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="ACTIVE" FontSize="8" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                    </Grid>

                                    <Grid Grid.Row="1" Margin="12,9,12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Theme.DisplayName}" FontWeight="SemiBold"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Background="{DynamicResource SurfaceMutedBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                    Padding="5,2" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding ModeLabel}" FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Theme.Description}" FontSize="9.5"
                                                   Margin="0,5,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="NoResultsPanel" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,70">
                    <TextBlock Text="NO MATCHING PALETTES" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Try another name or switch the light/dark filter."
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="22,10">
            <Grid>
                <TextBlock x:Name="ResultCountText" Text="11 palettes" FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="TYPE TO FILTER  •  TAB TO NAVIGATE  •  ESC TO CLOSE"
                           HorizontalAlignment="Right" FontSize="8" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
