<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MarkdownEditor.Core\MarkdownEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>MarkdownEditor.ico</ApplicationIcon>
    <EditorProjectDirectory>$(MSBuildProjectDirectory)\..\..\web\editor</EditorProjectDirectory>
  </PropertyGroup>

  <Target Name="BuildEditorAssets" BeforeTargets="Build">
    <Exec WorkingDirectory="$(EditorProjectDirectory)"
          Command="npm.cmd ci --no-audit --no-fund"
          Condition="!Exists('$(EditorProjectDirectory)\node_modules\.package-lock.json')" />
    <Exec WorkingDirectory="$(EditorProjectDirectory)" Command="npm.cmd run build" />
  </Target>

  <Target Name="CopyEditorAssets" AfterTargets="Build">
    <ItemGroup>
      <EditorAsset Include="$(EditorProjectDirectory)\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorAsset)"
          DestinationFiles="@(EditorAsset->'$(OutDir)EditorAssets\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
